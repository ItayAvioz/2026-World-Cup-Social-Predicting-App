# Copy this file to `.env` and fill in the three secrets.
# `.env` is git-ignored — never commit real keys.

# ── Supabase (live, read-only) ────────────────────────────────────────────────
# The crew reads the SAME data the nightly-summary Edge Function reads. To see
# other members' predictions it must bypass RLS exactly like the EF does, so it
# needs the SERVICE-ROLE key (not the anon key — anon is gated by RLS and would
# see almost nothing).
#   Where: Supabase dashboard → Project Settings → API → `service_role` (secret).
#   Use the DEV project first (ftryuvfdihmhlzvbpfeu) to play safely.
SUPABASE_URL=https://ftryuvfdihmhlzvbpfeu.supabase.co
SUPABASE_SERVICE_KEY=

# ── OpenAI (the LLM behind the agents) ────────────────────────────────────────
# Same provider the EF uses. PydanticAI reads this var automatically.
OPENAI_API_KEY=

# ── Optional knobs (sensible defaults in app/config.py) ───────────────────────
# CREW_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o
# CREW_SEED=42
# CREW_TEMPERATURE=0.6
# JUDGE_MIN_TOTAL=7.0
# MAX_WRITER_ATTEMPTS=3
